# =====================================================================
# GAME RESOURCES MUST NEVER BE COMMITTED.
# Katawa Shoujo: Re-Engineered assets are CC BY-NC-ND; this repo only holds
# the runtime. ci/check-no-game-assets.sh enforces this in CI as well.
# =====================================================================

# Ren'Py game data and scripts
*.rpa
*.rpi
*.rpy
*.rpyc
*.rpym
*.rpymc
*.rpyb
*.rpu
**/game/
**/saves/
persistent
log.txt
traceback.txt
errors.txt

# Media (blocked everywhere; host assets are allow-listed below)
*.png
*.jpg
*.jpeg
*.webp
*.avif
*.gif
*.bmp
*.tga
*.dds
*.svg
