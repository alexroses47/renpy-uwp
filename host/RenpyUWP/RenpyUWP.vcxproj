<Project DefaultTargets="Build" ToolsVersion="17.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <ProjectGuid>{B3861585-5323-4E8F-BCB8-B14F90B6097D}</ProjectGuid>
    <RootNamespace>RenpyUWP</RootNamespace>
    <ProjectName>RenpyUWP</ProjectName>
    <DefaultLanguage>en-US</DefaultLanguage>
    <MinimumVisualStudioVersion>17.0</MinimumVisualStudioVersion>
    <AppContainerApplication>true</AppContainerApplication>
    <ApplicationType>Windows Store</ApplicationType>
    <ApplicationTypeRevision>10.0</ApplicationTypeRevision>
    <WindowsTargetPlatformVersion>10.0.22621.0</WindowsTargetPlatformVersion>
    <WindowsTargetPlatformMinVersion>10.0.19041.0</WindowsTargetPlatformMinVersion>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset>v143</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Debug'" Label="Configuration">
    <UseDebugLibraries>true</UseDebugLibraries>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'" Label="Configuration">
    <UseDebugLibraries>false</UseDebugLibraries>
    <WholeProgramOptimization>true</WholeProgramOptimization>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <PropertyGroup>
    <!-- SDL2 install prefix produced by deps/sdl2/build.ps1 (CI passes /p:SdlDir=...). -->
    <SdlDir Condition="'$(SdlDir)'==''">$(MSBuildThisFileDirectory)..\..\out\deps\sdl2</SdlDir>
    <!-- CPython install prefix produced by python/cpython-uwp/build.ps1 (CI passes /p:PythonDir=...). -->
    <PythonDir Condition="'$(PythonDir)'==''">$(MSBuildThisFileDirectory)..\..\out\deps\cpython</PythonDir>
    <!-- Media dependencies (deps/media/build.ps1) and Ren'Py static modules (renpy/uwp/build.ps1). -->
    <MediaDir Condition="'$(MediaDir)'==''">$(MSBuildThisFileDirectory)..\..\out\deps\media</MediaDir>
    <!-- Exact libwebp library names depend on its CMake (checked in the media build log). -->
    <!-- libwebp's CMake adds a "lib" prefix under MSVC (CMakeLists.txt, webp_libname_prefix). -->
    <WebpLibs Condition="'$(WebpLibs)'==''">libwebp.lib;libwebpdemux.lib;libsharpyuv.lib</WebpLibs>
    <RenpyDir Condition="'$(RenpyDir)'==''">$(MSBuildThisFileDirectory)..\..\out\deps\renpy</RenpyDir>
    <!-- assimp (deps/assimp/build.ps1): required by renpy.gl2.assimp, imported unconditionally by Ren'Py. -->
    <AssimpDir Condition="'$(AssimpDir)'==''">$(MSBuildThisFileDirectory)..\..\out\deps\assimp</AssimpDir>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Packaging: sideload .msix, no bundle. Certificate is passed by CI on the command line. -->
    <GenerateAppxPackageOnBuild>true</GenerateAppxPackageOnBuild>
    <AppxBundle>Never</AppxBundle>
    <UapAppxPackageBuildMode>SideloadOnly</UapAppxPackageBuildMode>
    <AppxPackageSigningEnabled>true</AppxPackageSigningEnabled>
    <AppxAutoIncrementPackageRevision>false</AppxAutoIncrementPackageRevision>
    <GenerateAppInstallerFile>false</GenerateAppInstallerFile>
    <GenerateTestArtifacts>true</GenerateTestArtifacts>
    <AppxSymbolPackageEnabled>false</AppxSymbolPackageEnabled>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <CompileAsWinRT>false</CompileAsWinRT>
      <ConformanceMode>true</ConformanceMode>
      <WarningLevel>Level4</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <AdditionalOptions>/bigobj /utf-8 %(AdditionalOptions)</AdditionalOptions>
      <PreprocessorDefinitions>NOMINMAX;WIN32_LEAN_AND_MEAN;Py_NO_ENABLE_SHARED;__STDC_CONSTANT_MACROS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <!-- C++/WinRT projection headers shipped with the Windows SDK (no NuGet needed). -->
      <AdditionalIncludeDirectories>$(MediaDir)\include;$(PythonDir)\include;$(SdlDir)\include\SDL2;$(WindowsSdkDir)Include\$(WindowsTargetPlatformVersion)\cppwinrt;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <GenerateWindowsMetadata>false</GenerateWindowsMetadata>
      <AdditionalLibraryDirectories>$(RenpyDir)\lib;$(AssimpDir)\lib;$(MediaDir)\lib;$(PythonDir)\lib;$(SdlDir)\lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <!-- Python (and later Ren'Py) runs on the main/SDL thread: 8 MB stack like the old Python thread. -->
      <StackReserveSize>8388608</StackReserveSize>
      <!-- Strict mode: only WindowsApp.lib for system APIs (anything else must be justified in RESEARCH.md). -->
      <!-- ws2_32.lib after WindowsApp.lib: only for the data symbol in6addr_any (overlapped.c); functions still
           resolve through WindowsApp.lib. Kodi links ws2_32 for the same build (docs/RESEARCH.md section 22). -->
      <AdditionalDependencies>renpy_static.lib;assimp.lib;SDL2_image.lib;freetype.lib;harfbuzz.lib;fribidi.lib;png.lib;jpeg.lib;$(WebpLibs);avformat.lib;avcodec.lib;swresample.lib;swscale.lib;avutil.lib;python312.lib;zlibstatic.lib;expat_uwp.lib;mpdec_uwp.lib;SDL2.lib;WindowsApp.lib;ws2_32.lib</AdditionalDependencies>
      <IgnoreAllDefaultLibraries>false</IgnoreAllDefaultLibraries>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <Optimization>Disabled</Optimization>
      <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
    </Link>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClCompile Include="src\main.cpp" />
    <ClCompile Include="src\Log.cpp" />
    <ClCompile Include="src\Renderer.cpp" />
    <ClCompile Include="src\DisplayProbe.cpp" />
    <ClCompile Include="src\StorageProbe.cpp" />
    <ClCompile Include="src\PythonHost.cpp" />
    <ClCompile Include="src\BenchModule.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="src\Log.h" />
    <ClInclude Include="src\Renderer.h" />
    <ClInclude Include="src\DisplayProbe.h" />
    <ClInclude Include="src\StorageProbe.h" />
    <ClInclude Include="src\PythonHost.h" />
  </ItemGroup>
  <ItemGroup>
    <!-- Copied next to the project by CI (git-ignored); packaged at the package root. -->
    <None Include="SDL2.dll">
      <DeploymentContent>true</DeploymentContent>
    </None>
    <!-- ANGLE (SternXD fork, deps/angle): OpenGL ES on Direct3D 11, loaded by SDL's WinRT EGL code. -->
    <None Include="libEGL.dll">
      <DeploymentContent>true</DeploymentContent>
    </None>
    <None Include="libGLESv2.dll">
      <DeploymentContent>true</DeploymentContent>
    </None>
    <!-- renpy_base (renpy.py + renpy\common\), staged by CI from out/deps/renpy/renpy-base (git-ignored). -->
    <None Include="renpy-base\**\*">
      <DeploymentContent>true</DeploymentContent>
    </None>
    <!-- Embedded Python: stdlib zip copied here by CI (git-ignored) and the smoke test. -->
    <None Include="python\python312.zip">
      <DeploymentContent>true</DeploymentContent>
    </None>
    <None Include="python\smoke.py">
      <DeploymentContent>true</DeploymentContent>
    </None>
    <!-- Ren'Py launcher (renpy.py equivalent with UWP paths). -->
    <None Include="python\renpy_uwp_main.py">
      <DeploymentContent>true</DeploymentContent>
    </None>
    <None Include="python\media_test.py">
      <DeploymentContent>true</DeploymentContent>
    </None>
    <!-- Copied here by CI (git-ignored): Ren'Py package zip and synthetic test media. -->
    <None Include="python\renpy.zip">
      <DeploymentContent>true</DeploymentContent>
    </None>
    <None Include="python\site-packages.zip">
      <DeploymentContent>true</DeploymentContent>
    </None>
    <None Include="python\test\test.png">
      <DeploymentContent>true</DeploymentContent>
    </None>
    <None Include="python\test\test.ogg">
      <DeploymentContent>true</DeploymentContent>
    </None>
    <None Include="python\test\test-vp9.mkv">
      <DeploymentContent>true</DeploymentContent>
    </None>
    <None Include="python\test\test-vp9-10bit.mkv">
      <DeploymentContent>true</DeploymentContent>
    </None>
  </ItemGroup>
  <ItemGroup>
    <AppxManifest Include="Package.appxmanifest">
      <SubType>Designer</SubType>
    </AppxManifest>
  </ItemGroup>
  <ItemGroup>
    <Image Include="Assets\StoreLogo.png" />
    <Image Include="Assets\Square150x150Logo.png" />
    <Image Include="Assets\Square44x44Logo.png" />
    <Image Include="Assets\Wide310x150Logo.png" />
    <Image Include="Assets\SplashScreen.png" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
